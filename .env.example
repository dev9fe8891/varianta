# Application
PORT=3000
NODE_ENV=development

# CORS
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# CSRF
# Comma-separated list of trusted origins for state-changing requests.
CSRF_ORIGINS=http://localhost:5173,http://localhost:3000,https://varianta.5goosh.ir

# PostgreSQL connection string
# Replace the placeholder password with your local database password.
DATABASE_URL="postgresql://varianta_user:YOUR_LOCAL_PASSWORD@localhost:5432/varianta_db?schema=public"

# Authentication
# Use a long, random secret outside tests.
JWT_SECRET=replace-with-a-long-random-secret
